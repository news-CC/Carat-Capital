# ─────────────────────────────────────────────────────────────────────────────
# SALON MALONE — environment
#
# Copy to .env.local and fill in. Everything here also has to exist in Vercel
# (Settings → Environment Variables) or the deployed app will boot and then fail
# at the first call site that needs a missing key.
#
# src/lib/env.ts is the only module allowed to read process.env. If you add a
# variable, add it to ServerEnvKey there too.
# ─────────────────────────────────────────────────────────────────────────────


# ── SUPABASE ─────────────────────────────────────────────────────────────────
# The only datastore. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS, which is the entire access model here: RLS is
# enabled on all 5 tables with ZERO policies, so the anon key can read nothing
# and every server-side query uses this key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# ── APP ──────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for absolute links and as the default
# base for the Vapi webhook URL in scripts/setup-vapi.mjs.
NEXT_PUBLIC_APP_URL=

# "Book a call" destination for the one CTA on the marketing page (Cal.com,
# Calendly, a mailto: — whatever you actually answer).
NEXT_PUBLIC_BOOKING_CALL_URL=
BOOKING_CALL_URL=


# ── ADMIN LOGIN ──────────────────────────────────────────────────────────────
# There is no user table and no signup. This single credential pair is the whole
# auth system.
ADMIN_EMAIL=

# Generate with:  printf %s 'your long passphrase' | node scripts/hash-password.mjs
# Format: scrypt$<saltHex>$<keyHex>
# This value also keys the session cookie HMAC — changing it signs you out.
ADMIN_PASSWORD_HASH=


# ── VAPI (voice) ─────────────────────────────────────────────────────────────
# Private API key from the Vapi dashboard. VAPI_ASSISTANT_ID and
# VAPI_PHONE_NUMBER_ID are printed by:  npm run setup:vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Shared secret Vapi sends back as the x-vapi-secret header. The webhook rejects
# anything else with a 401, so this must match what the assistant was configured
# with. setup:vapi generates one if it is blank.
VAPI_WEBHOOK_SECRET=


# ── RESEND (email) ───────────────────────────────────────────────────────────
# The booking alert and the Friday report. The Friday report is the retention
# product, so use a from-address on a domain you have actually verified.
RESEND_API_KEY=
EMAIL_FROM="Salon Malone <malone@yourdomain.com>"


# ── STRIPE (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# Signing secret for the endpoint you add at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Payment links. Created and printed by:  npm run setup:stripe
# Both forms are required for each plan. The server copies are for reference and
# server-side use; the NEXT_PUBLIC_ copies are what the pricing buttons on the
# marketing page read, because that markup is rendered in the browser.
STRIPE_LINK_SALON_399=
STRIPE_LINK_MEDSPA_999=
STRIPE_LINK_GROUP_2499=
STRIPE_LINK_PILOT_299=

NEXT_PUBLIC_STRIPE_LINK_SALON_399=
NEXT_PUBLIC_STRIPE_LINK_MEDSPA_999=
NEXT_PUBLIC_STRIPE_LINK_GROUP_2499=
NEXT_PUBLIC_STRIPE_LINK_PILOT_299=


# ── CRON ─────────────────────────────────────────────────────────────────────
# Long random string. /api/cron/dial and /api/cron/report accept either
# `Authorization: Bearer $CRON_SECRET` or Vercel's own x-vercel-cron header.
# Generate with:  openssl rand -hex 32
CRON_SECRET=


# ── COMPLIANCE GATES ─────────────────────────────────────────────────────────
# These are guard rails, not preferences. Read the comments before changing them.

# Calling window in each CLIENT's local timezone (clients.timezone), 24h HH:MM.
# Defaults 09:00 / 19:00. An unparseable client timezone fails closed — no dial.
CALL_WINDOW_START=09:00
CALL_WINDOW_END=19:00

# Consent gate. Any value other than the exact string "false" keeps the gate on.
#
# What "false" actually does, and does not do:
#   - It lets a row with a BLANK consent cell be STORED, for lists where consent is
#     evidenced somewhere other than the spreadsheet. Nothing else.
#   - A cell that says no out loud (no / false / f / 0 / opt_out / unsubscribed /
#     revoked / stop / do_not_call / dnc) is dropped either way. No operator setting
#     overrides a written refusal.
#   - Rows kept this way are stored with consent = false, and the dialer's hard gate
#     is `consent = true` in SQL — so they sit in the table and can never be called.
# Leave it alone.
REQUIRE_CONSENT_FLAG=true

# Simultaneous Vapi calls. The default plan has 10 lines; 8 leaves headroom.
MAX_CONCURRENT_CALLS=8

# 555-0100..555-0199 is the range reserved for fiction, and the whole demo list in
# demo/ lives in it. The scrub KEEPS those numbers (the demo needs rows in the table)
# and the dialer skips them, so a stray campaign cannot burn 250 attempts on numbers
# that do not route. Only the exact string "true" turns the skip off, and the only
# reason to do that is to prove the skip is what is happening. Unset means off.
DIAL_FICTIONAL_NUMBERS=false


# ── LOCAL SCRIPTS ONLY (never read by the app) ───────────────────────────────
# Postgres connection URI, for applying the migration with psql instead of the
# SQL Editor. Project Settings → Database → Connection string → URI.
# Optional: scripts/apply-migration.mjs prints the psql command when it is set.
SUPABASE_DB_URL=
